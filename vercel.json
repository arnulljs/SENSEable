{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/orgs/wipe-cron",
      "destination": "/api/orgs?action=wipe-cron"
    },
    {
      "source": "/api/orgs/(.*)",
      "destination": "/api/orgs?action=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/router?path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://senseable-iot.vercel.app; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/orgs/wipe-cron",
      "schedule": "0 18 * * *"
    }
  ]
}
